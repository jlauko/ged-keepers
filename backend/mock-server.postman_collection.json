{
  "info": {
    "name": "Mock Server API",
    "_postman_id": "mock-server-api",
    "description": "Endpoints for testing mock server without MongoDB",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"secret\"\n}"
        },
        "url": {
          "raw": "http://localhost:4000/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "Get All Attachments",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:4000/attachments",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["attachments"]
        }
      }
    },
    {
      "name": "Get Attachments by NodeId",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:4000/attachments/A1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["attachments", "A1"]
        }
      }
    },
    {
      "name": "Add Attachment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nodeId\": \"C3\",\n  \"filename\": \"new_doc.txt\"\n}"
        },
        "url": {
          "raw": "http://localhost:4000/attachments",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["attachments"]
        }
      }
    },
    {
      "name": "Delete Attachment",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "http://localhost:4000/attachments/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["attachments", "1"]
        }
      }
    }
  ]
}
