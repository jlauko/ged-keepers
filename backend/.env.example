# Copy to backend/.env for local dev. Never commit the real .env.
# On Render, set these in the Environment tab instead.

# Signs admin session tokens. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED - the server refuses to start without it.
JWT_SECRET=dev-only-change-me

# The editor password. Login is disabled until this is set.
ADMIN_PASSWORD=changeme

# Which tree (users/<name>/ folder) the password unlocks. Defaults to "lauko".
# ADMIN_USERNAME=lauko

# Optional. Defaults to 4000. Render injects its own PORT.
PORT=4000
