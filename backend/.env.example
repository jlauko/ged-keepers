# Copy to backend/.env for local dev. Never commit the real .env.
# On Render, set these in the Environment tab instead.

# Signs session tokens. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED - the server refuses to start without it.
JWT_SECRET=dev-only-change-me

# --- Tree credentials ---
# Preferred: backend/trees.json (gitignored; a Render Secret File in prod),
#   { "<tree>": { "viewHash": "<bcrypt>", "adminHash": "<bcrypt>" } }
#   manage with:  node scripts/set-tree-password.js <tree> <view|admin>
#
# Legacy fallback below - only used for the ADMIN_USERNAME tree when trees.json
# has no entry for it. Fine for local dev; drop once trees.json is in place.
VIEW_PASSWORD=changeme-view
ADMIN_PASSWORD=changeme-admin
# ADMIN_USERNAME=lauko

# Cloudflare R2 - attachment storage. From the R2 dashboard: create a bucket,
# then "Manage R2 API Tokens" -> create an Object Read & Write token.
# If these are unset, attachment upload/serve/delete return 503 (the rest of
# the app still works).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ged-keepers

# Optional. Defaults to 4000. Render injects its own PORT.
PORT=4000

# MongoDB Atlas - stores per-node biography/evidence/attachment metadata
# (backend/models/NodeInfo.js). Create a free M0 cluster, a database user,
# and allow Network Access from 0.0.0.0/0 (Render has no static outbound IP).
# Include a database name in the path or it silently connects to "test":
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ged-keepers?...
# REQUIRED - the server refuses to start without it.
MONGODB_URI=
